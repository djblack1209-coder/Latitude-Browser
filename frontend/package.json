{
  "name": "latitude-browser-frontend",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "ensure:native": "node ./scripts/ensure-rollup-native.mjs",
    "postinstall": "npm run ensure:native",
    "dev": "node ./scripts/dev-watcher.mjs",
    "dev:raw": "npm run ensure:native && node --max-old-space-size=256 --max-semi-space-size=16 ./node_modules/vite/bin/vite.js",
    "build": "npm run build:keep",
    "build:keep": "npm run ensure:native && node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc && node --max-old-space-size=1024 ./node_modules/vite/bin/vite.js build",
    "build:clean": "cross-env FRONTEND_CLEAN_DIST=1 npm run build:keep",
    "preview": "npm run ensure:native && node --max-old-space-size=256 --max-semi-space-size=16 ./node_modules/vite/bin/vite.js preview",
    "demo": "cross-env VITE_ENABLE_DEV_MOCK=true npm run dev:raw -- --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs ../backend/internal/automation/tests/*.test.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "js-yaml": "5.5.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.6.2",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "semver": "7.8.6",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
